# Скопируйте в .env и заполните. Значения Supabase — из supabase/docker/.env
DATABASE_URL=postgresql://postgres:ПАРОЛЬ_POSTGRES@supabase-db:5432/postgres
SUPABASE_URL=http://supabase-envoy:8000
SUPABASE_SERVICE_KEY=service_role_ключ
SUPABASE_JWT_SECRET=JWT_SECRET_из_supabase
DEEPSEEK_API_KEY=
# запасной провайдер (данные в РФ), для клиентов с llm_provider='yandex'
YC_FOLDER_ID=
YC_LLM_API_KEY=
NUM_THREADS=4
DIARIZATION_THRESHOLD=0.6
